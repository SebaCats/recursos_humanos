<!-- Contenido principal -->
<div class="container-fluid p-0 mt-3">
    <h1>Las personas en perspectiva</h1>
    <p class="text-body-tertiary">Una visión de tu equipo y de las decisiones que necesitan tu atención.</p>
</div>

<!-- Cards de información-->
<div class="container-fluid p-0">
    <div class="row g-3">
        <!-- Card plantilla -->
        <div class="col-12 col-sm-6 col-md-3">
            <article class="card shadow-b p-3 h-100">
                <section class="text-body-tertiary">Plantilla activa</section>
                <h1 id="plantillaActiva">250</h1>
                <small class="text-success">+5 personas respecto a septiembre</small>
            </article>
        </div>
        <!-- Card rotación -->
        <div class="col-12 col-sm-6 col-md-3">
            <article class="card shadow-b p-3 h-100">
                <section class="text-body-tertiary">Rotación acumulada</section>
                <h1>2,8%</h1>
                <small class="text-success">-0,3 pp · últimos 12 meses</small>
            </article>
        </div>
        <!-- Card ausentismo -->
        <div class="col-12 col-sm-6 col-md-3">
            <article class="card shadow-b p-3 h-100">
                <section class="text-body-tertiary">Ausentismo mensual</section>
                <h1>3,2%</h1>
                <small class="text-success">Objetivo interno: menos de 4 %</small>
            </article>
        </div>
        <!-- Card coste nómina -->
        <div class="col-12 col-sm-6 col-md-3">
            <article class="card shadow-b p-3 h-100">
                <section class="text-body-tertiary">Coste de nómina previsto</section>
                <h1 id="totalNomina">$707.678.740</h1>
                <small class="text-success">Octubre · pendiente de cierre</small>
            </article>
        </div>
    </div>
</div>

<!-- Sección de gráficas (2 columnas) -->
<div class="container-fluid p-0 my-3">
    <div class="row g-3">
        <!-- Card evolución plantilla -->
        <div class="col-8">
            <article class="card shadow-b p-3 h-100">
                <section>
                    <h4>Evolución de la plantilla</h4>
                    <small class="text-body-tertiary">Personas activas al cierre de cada mes</small>
                </section>
                <canvas style="max-height: 250px;" id="myChart" role="img"
                    aria-label="Evolución mensual de la plantilla activa"></canvas>
                <div class="d-flex justify-content-between h-100 align-items-end">
                    <small class="text-body-tertiary">Altas en octubre: 8 - Bajas: 4</small>
                    <small class="text-primary">Ver movimiento de plantilla →</small>
                </div>
            </article>
        </div>

        <!-- Card distribución departamento -->
        <div class="col-4">
            <article class="card shadow-b p-3 h-100">
                <section>
                    <h4>Distribución por departamento</h4>
                    <small id="totalPlantillaText" class="text-body-tertiary">250 personas - plantilla actual</small>
                </section>
                <!-- Barras de progreso -->
                <div id="progressDiv" class="d-flex flex-column gap-1">
                    <div class="d-flex justify-content-between">
                        <small>Operaciones</small>
                        <small>25 - 10%</small>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Basic example" aria-valuenow="10"
                        aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: 10%"></div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <small>Tecnología</small>
                        <small>75 - 30%</small>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Basic example" aria-valuenow="30"
                        aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: 30%"></div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <small>Comercial</small>
                        <small>50 - 20%</small>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Basic example" aria-valuenow="20"
                        aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: 20%"></div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <small>Finanzas</small>
                        <small>80 - 32%</small>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Basic example" aria-valuenow="32"
                        aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: 32%"></div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <small>Personas</small>
                        <small>20 - 8%</small>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Basic example" aria-valuenow="8"
                        aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: 8%"></div>
                    </div>
                </div>
            </article>
        </div>
        <!-- Card decisiones -->
        <div class="col-8">
            <article class="card shadow-b p-3 h-100">
                <section>
                    <h4>Tú bandeja de decisiones</h4>
                    <small class="text-body-tertiary">Personas activas al cierre de cada mes</small>
                </section>

                <table class="table">
                    <thead>
                        <tr">
                            <th scope="col">SOLICITUDES</th>
                            <th scope="col">RESPONSABLE</th>
                            <th scope="col">VENCE</th>
                            <th scope="col">ESTADO</th>
                            </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Vacaciones · Ana García</td>
                            <td>Carlos Ruiz</td>
                            <td>Hoy</td>
                            <td>● Pendiente</td>
                        </tr>
                        <tr>
                            <td>Revisión de nómina</td>
                            <td>Lucía Vega</td>
                            <td>28 oct</td>
                            <td>● Incidencias</td>
                        </tr>
                        <tr>
                            <td>Contrato · Diego Pardo</td>
                            <td>Lucía Vega</td>
                            <td>21 oct</td>
                            <td>● Pendiente</td>
                        </tr>
                    </tbody>
                </table>
                <div class="d-flex justify-content-between h-100 align-items-end">
                    <small class="text-primary">Ver los 7 pendientes →</small>
                </div>
            </article>
        </div>
        <!-- Card actividad reciente -->
        <div class="col-4">
            <article class="card shadow-b p-3 h-100">
                <section>
                    <h4>Actividad reciente</h4>
                    <small class="text-body-tertiary">246 personas - plantilla actual</small>
                </section>
                <ul class="list-group list-group-flush border-top-0">
                    <li class="list-group-item">Marta Soler actualizó un objetivo</li>
                    <li class="list-group-item">Diego Pardo completó su perfil</li>
                    <li class="list-group-item">Carlos Ruiz aprobó 2 ausencias</li>
                    <li class="list-group-item">Nómina de septiembre publicada</li>
                </ul>
                <div class="d-flex justify-content-between h-100 align-items-end">
                    <small class="text-primary">Abrir registro de actividad →</small>
                </div>
            </article>
        </div>

    </div>
</div>

<div class="container-fluid p-0 my-3">
    <article class="card shadow-b p-3 bg-primary-subtle border-0">
        <strong class="text-primary">Próximo hito: cierre de nóminas de octubre</strong>
        <small class="text-primary">Valida incidencias antes del 28 oct. El pago está previsto para el 30 oct y
            requiere aprobación de Finanzas.</small>
    </article>
</div>
