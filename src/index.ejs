<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RR.HH.</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles.css">
</head>

<body class="d-flex flex-row bg-gray">

    <!-- Barra lateral -->
    <aside class="d-flex flex-column vh-100 p-3 border-end bg-white shadow-r" style="min-width: 250px;">
        <!-- Sección usuario -->
        <section class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom">
            <img src="https://randomuser.me/api/portraits/thumb/men/75.jpg" class="rounded-circle" width="36"
                height="36" alt="Usuario">
            <div class="overflow-hidden">
                <strong class="d-block text-truncate">Usuario Prueba</strong>
                <small class="text-body-tertiary d-block text-truncate">Admin</small>
            </div>
        </section>

        <!-- Menú de navegación -->
        <nav class="flex-grow-1">
            <ul class="nav nav-pills flex-column gap-2">
                <li id="resumen" class="nav-item bg-primary-subtle rounded fw-bold">
                    <a href="/resumen" class="nav-link px-2">Resumen</a>
                </li>
                <li id="directorio" class="nav-item rounded fw-bold">
                    <a href="/directorio" class="nav-link px-2">Directorio</a>
                </li>
            </ul>
        </nav>
        <a class="btn btn-secondary bg-primary fw-bold" href="/logout">Cerrar sesión</a>
    </aside>

    <!-- Área de contenido principal -->
    <div class="flex-grow-1 d-flex flex-column overflow-auto vh-100">
        <!-- Header  -->
        <header
            class="sticky-top z-3 d-flex align-items-center justify-content-between p-3 mx-4 mt-0 rounded border-bottom shadow-b bg-white">
            <h5 class="text-body-tertiary d-flex m-0">Horizon ><div class="text-black mx-1">Recursos humanos</div>
            </h5>
            <input class="form-control me-2 search-icon bg-gray border-0" type="search"
                placeholder="Buscar en mi empresa..." style="width: 250px;" />
        </header>

        <!-- Contenido principal -->
        <main class="flex-grow-1 px-4">
            <%- include(vista) %>
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="js/graficas.js"></script>
    <script src="utils/resumen.js"></script>
</body>

</html>